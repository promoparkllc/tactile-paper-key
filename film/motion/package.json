{
  "name": "tactile-film-motion",
  "private": true,
  "version": "0.1.0",
  "description": "Remotion layer of the Tactile — Paper Key explainer: titles, callouts, grid, CSS typing, timecodes, HUD, end card. Timing from ../scenes.json, callouts from ../anchors_s2.json.",
  "scripts": {
    "sync": "node scripts/sync-data.mjs",
    "studio": "npm run sync && remotion studio",
    "stills": "node scripts/stills.mjs",
    "contrast": "node scripts/contrast.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "^1.65.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
